# ---------- 千问 / DashScope（公网或政务云 MaaS） ----------
# 不填则自动进入“离线演示模式”，使用可引用的检索式回答。
QWEN_API_KEY=
# 数据不出内网：公网端点默认阻止。确需使用公网 DashScope/OpenAI，显式设 1
ALLOW_EXTERNAL_LLM=0
# 默认即 DashScope + qwen-plus；如需改写再取消注释
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus

# ---------- 内网私有化 Qwen（vLLM / SGLang / Ollama 的 OpenAI 兼容接口） ----------
# 内网部署时优先使用这一组配置，评审材料不出域。
# QWEN_BASE_URL=http://10.0.0.10:8000/v1
# QWEN_API_KEY=EMPTY
# QWEN_MODEL=Qwen3-32B

# ---------- 其他 OpenAI 兼容服务（可选） ----------
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ---------- 运行参数 ----------
HOST=127.0.0.1
PORT=8010
LLM_TIMEOUT=90
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1400
# Qwen3 思考模式：0=关闭（推荐）；留空=不发送该参数
# LLM_ENABLE_THINKING=0

# 数据目录与检索参数（一般无需修改）
# DATA_DIR=./data
# DB_PATH=./data/app.db
MAX_UPLOAD_BYTES=31457280
MAX_CONTENT_CHARS=60000
MAX_DOCX_UNCOMPRESSED_BYTES=125829120
CHUNK_SIZE=700
CHUNK_OVERLAP=100
TOP_K=7

# 登录失败限速（同一用户名 + IP）
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=300
# HTTPS 部署时设为 1（会话 Cookie 仅经加密连接传输）
COOKIE_SECURE=0

# 是否自动写入演示数据：42 篇合成文献（安全，默认开）
SEED_DEMO_PAPERS=1
# 是否把本地真实申请书复制为示例本子（含个人信息）；默认关，仅本机演示时显式开
SEED_SAMPLE_DOC=0

# 演示账号（admin/manager/reviewer/viewer）：
# 留空 = 仅本机监听时自动创建；对外监听默认不创建。
# 非本机环境确需演示，显式设 1，并设置强密码（留空则生成随机密码并打印到日志）。
SEED_DEMO_USERS=
# DEMO_USER_PASSWORD=请改成强密码

# ---------- 外部数据接入（预留） ----------
# 设置后，/api/ingest/* 推送接口要求请求头 X-INGEST-Token 与之匹配；
# 留空时，需以 manager/admin 登录会话推送（未登录会 403）。
INGEST_TOKEN=
