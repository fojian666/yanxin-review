# ---------- 千问 / DashScope（公网或政务云 MaaS） ----------
# 不填则自动进入“离线演示模式”，使用可引用的检索式回答。
QWEN_API_KEY=
# 默认即 DashScope + qwen-plus；如需改写再取消注释
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus

# ---------- 内网私有化 Qwen（vLLM / SGLang / Ollama 的 OpenAI 兼容接口） ----------
# 内网部署时优先使用这一组配置，评审材料不出域。
# QWEN_BASE_URL=http://10.0.0.10:8000/v1
# QWEN_API_KEY=EMPTY
# QWEN_MODEL=Qwen3-32B

# ---------- 其他 OpenAI 兼容服务（可选） ----------
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ---------- 运行参数 ----------
HOST=127.0.0.1
PORT=8010
LLM_TIMEOUT=90
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1400

# 是否自动写入演示数据：示例本子 + 42 篇合成文献
SEED_SAMPLE_DOC=1
SEED_DEMO_PAPERS=1
