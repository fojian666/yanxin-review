# ---------- 检索：嵌入（向量）后端 ----------
# auto=本地优先、没有就用 API、都没有退回纯 TF-IDF；local/api/none 可强制指定。
# 真实评审材料请用 local 或内网端点，别走公网（见 SECURITY.md §5）。
EMBED_BACKEND=auto
# EMBED_API_KEY=
# EMBED_BASE_URL=https://api.siliconflow.cn/v1
# EMBED_MODEL=BAAI/bge-m3
# EMBED_BATCH=16
# EMBED_TIMEOUT=60
# 向量结果下限：低于此值视为「没有相关资料」（TF-IDF 不适用，其无关文本余弦接近 0）
# EMBED_MIN_SCORE=0.45
# 公网嵌入端点默认拦住；确需使用公网 API 时显式设 1
ALLOW_EXTERNAL_EMBED=0
# 本地模型目录（EMBED_BACKEND=local 时用，模型文件不进仓库）
# EMBED_MODEL=./models/bge-m3

# ---------- 大模型 ----------
# LLM_PROVIDER：qwen / deepseek / openai / custom / auto（默认，按已配置的 key 推断）
# 预设只需填对应 key，base_url 与模型名自动带出；留空 key 即离线模式。
LLM_PROVIDER=auto

# 千问 DashScope（预设 qwen）
QWEN_API_KEY=
# DASHSCOPE_API_KEY=          # 也认这个别名
# LLM_MODEL=qwen-plus

# OpenAI（预设 openai）
# OPENAI_API_KEY=sk-...

# DeepSeek（预设 deepseek）
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-...

# 内网 / 自建（预设 custom）：vLLM / SGLang / Ollama 的 OpenAI 兼容接口
# LLM_PROVIDER=custom
# LLM_BASE_URL=http://10.0.0.10:8000/v1
# LLM_MODEL=Qwen3-32B
# LLM_API_KEY=EMPTY           # 内网通常不校验，可留空

# 通用覆盖（任何预设都认这个，别用历史变量覆盖，避免把 A 家 key 发到 B 家）
# LLM_MODEL=qwen-max

# 历史兼容变量：仅在 LLM_PROVIDER=auto（旧写法）时生效；
# 预设模式不认它们，防止留着 A 家的地址却换成 B 家的 key。
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 数据不出内网：公网端点（DashScope / DeepSeek / OpenAI）默认被代码阻止，
# 确需使用请显式设 1，并完成数据出域审批。
ALLOW_EXTERNAL_LLM=0

# ---------- 运行参数 ----------
HOST=127.0.0.1
PORT=8010
LLM_TIMEOUT=90
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1400
# 思考模式：0=关闭（推荐，JSON 任务必须关）；留空=不发送该参数
# LLM_ENABLE_THINKING=0
# 思考参数方言：auto 按端点推断（含 deepseek → thinking.type，其余 → enable_thinking）
# LLM_THINKING_STYLE=auto

# 数据目录与检索参数（一般无需修改）
# DATA_DIR=./data
# DB_PATH=./data/app.db
MAX_UPLOAD_BYTES=31457280
MAX_CONTENT_CHARS=60000
MAX_DOCX_UNCOMPRESSED_BYTES=125829120
MAX_PDF_PAGES=2000
CHUNK_SIZE=700
CHUNK_OVERLAP=100
TOP_K=7

# 登录失败限速（同一用户名 + IP）
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=300
# HTTPS 部署时设为 1（会话 Cookie 仅经加密连接传输）
COOKIE_SECURE=0

# 是否自动写入演示数据：42 篇合成文献 + 10 份虚构演示本子（安全，默认开）
SEED_DEMO_PAPERS=1
SEED_DEMO_PROPOSALS=1
# 是否把本地真实申请书复制为示例本子（含个人信息）；默认关，仅本机演示时显式开
SEED_SAMPLE_DOC=0

# 演示账号（admin/manager/reviewer/viewer）：
# 留空 = 仅本机监听时自动创建；对外监听默认不创建。
# 非本机环境确需演示，显式设 1，并设置强密码（留空则生成随机密码并打印到日志）。
SEED_DEMO_USERS=
# DEMO_USER_PASSWORD=请改成强密码

# ---------- 外部数据接入（预留） ----------
# 设置后，/api/ingest/* 推送接口要求请求头 X-INGEST-Token 与之匹配；
# 留空时，需以 manager/admin 登录会话推送（未登录会 403）。
INGEST_TOKEN=
